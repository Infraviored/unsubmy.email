# Database Configuration
# In production, replace YOUR_POSTGRES_PASSWORD_HERE with a strong password
# and update DATABASE_URL accordingly.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_POSTGRES_PASSWORD_HERE@db:5432/unsubmyemail

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Security (Run 'openssl rand -hex 32' to generate a secure secret)
SECRET_KEY=YOUR_SECRET_KEY_HERE

# Postgres container configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
POSTGRES_DB=unsubmyemail

# SQL Debugging (set to true to see all queries)
DATABASE_ECHO=false
